{
  // Satu aplikasi Astro 5 untuk SEMUA restoran. Tidak ada deploy atau DNS per restoran.
  "name": "dapora-sites",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },

  // Wildcard Workers Route — butuh record DNS wildcard BERPROKSI (lihat README-DAPORA.md, langkah C2).
  "routes": [{ "pattern": "*.dapora.id/*", "zone_name": "dapora.id" }],

  "vars": {
    "API_URL": "https://admin.dapora.id",
    "BASE_DOMAIN": "dapora.id",
    "MEDIA_URL": "https://images.kokofibo.com"
    // DEFAULT_SITE_SLUG: jangan diisi di produksi
  }
  // Bila build/adapter meminta binding SESSION (error "Invalid binding SESSION"), tambahkan:
  // "kv_namespaces": [{ "binding": "SESSION", "id": "<id-kv>" }]
}

---
import type { Site } from '../data/types';
import { href, pick } from '../i18n';
import { ui } from '../i18n/ui';
import { navRoutesFor } from '../routes';
import LangSwitch from './LangSwitch.astro';
interface Props { site: Site; lang: string; slug: string; brand: string; tagline: string | null }
const { site, lang, slug, brand, tagline } = Astro.props;
// Halaman pesan online (/pesan, /pesanan/<token>): tanpa tautan Beranda dan Order. Logo/nama restoran, Menu, Kontak, dan bahasa tetap ada.
const focused = slug === 'pesan' || slug.startsWith('pesanan');
const links = navRoutesFor(site).filter(r => !(focused && (r.key === 'home' || r.key === 'order')));
---
<header id="site-header"><div class="wrap">
  <a class="brand" href={href(site, lang)}>
    <span class="logo" aria-hidden="true">{brand[0]}</span>
    <span><b>{brand}</b>{tagline && <small>{tagline}</small>}</span>
  </a>
  <nav id="nav" aria-label={pick(ui.menuLabel, lang)}>
    {links.map(r => (
      <a href={href(site, lang, r.slug)} class={(r.slug === slug ? 'on' : '') + (r.key === 'order' ? ' ordn' : '')}
         aria-current={r.slug === slug ? 'page' : undefined} data-meja={r.key === 'order' ? '' : undefined}>{pick(r.label, lang)}</a>
    ))}
  </nav>
  <div class="tools">
    <LangSwitch site={site} lang={lang} slug={slug} />
    <button class="modebtn" id="modeBtn" type="button" aria-pressed="false" data-l-dark={pick(ui.mode.dark, lang)} data-l-light={pick(ui.mode.light, lang)} aria-label={pick(ui.mode.dark, lang)} title={pick(ui.mode.dark, lang)}>
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button class="burger" id="burger" type="button" aria-label={pick(ui.menuLabel, lang)} aria-expanded="false" aria-controls="nav">☰</button>
  </div>
</div></header>

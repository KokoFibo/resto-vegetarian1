---
import PageHead from '../components/PageHead.astro';
import DishTags from '../components/DishTags.astro';
import Utensils from '../components/Utensils.astro';
import { href, loc, lbl, pick } from '../i18n';
import { ui } from '../i18n/ui';
import { rupiah } from '../lib/format';
import { env } from '../lib/env';
import type { ViewProps } from './types';
const { lang, site, menu } = Astro.props as ViewProps;
const primary = site.languages[0];
const L = (t: Parameters<typeof pick>[0]) => pick(t, lang);
const errors = Object.fromEntries(Object.entries(ui.errors).map(([code, t]) => [code, pick(t, lang)]));
const closed = site.orders_open === false;
const prepay = site.online?.prepay === true;
const sitekey = env(Astro.locals, 'TURNSTILE_SITEKEY') || '';
const groups = menu.cats.map(c => ({ cat: c, dishes: menu.dishes.filter(d => d.cat === c.slug) })).filter(g => g.dishes.length);
---
<PageHead title={L(ui.online.title)}>{closed ? L(ui.online.closedBody) : L(ui.online.lead)}</PageHead>
{closed ? (
  <section class="after-head"><div class="wrap"><div class="panel scanbox rv" role="status">
    <span class="jade"><Utensils size={44} /></span>
    <h3>{L(ui.online.closedTitle)}</h3>
    <p><a class="btn" href={href(site, lang, 'menu')}>{L(ui.viewMenu)}</a></p>
  </div></div></section>
) : (
  <section class="after-head"><div class="wrap">
    <form id="pesanForm" class="ordergrid" data-lang={lang} data-sitekey={sitekey}
          data-errs={JSON.stringify(errors)} data-empty={L(ui.online.nothing)}>
      <div>
        {groups.map(g => (
          <div class="rv ogroup">
            <h3>{loc(g.cat.name, lang, primary)}</h3>
            {g.dishes.map(d => (
              <div class={'oi' + (d.soldOut ? ' off' : '')} data-id={d.id} data-price={d.price} data-name={loc(d.name, lang, primary)}>
                <div>
                  <h4>{loc(d.name, lang, primary)}</h4><span class="price">{rupiah(d.price)}</span>
                  <div class="tags"><DishTags dish={d} lang={lang} primary={primary} /></div>
                </div>
                <div class="qty">
                  <button type="button" data-d="-" aria-label="−" disabled={d.soldOut}>−</button>
                  <output>0</output>
                  <button type="button" data-d="+" aria-label="+" disabled={d.soldOut}>+</button>
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
      <aside class="panel sum rv" style="--d:.15s">
        <h3>{L(ui.online.yourOrder)}</h3>
        <ul id="lines"></ul>
        <div class="row"><b>{L(ui.online.subtotal)}</b><b id="total" class="price">Rp 0</b></div>
        <p class="muted small">{L(ui.online.feesNote)}</p>
        <label>{L(ui.online.name)}<input name="name" maxlength="60" autocomplete="name" required /></label>
        <label>{L(ui.online.phone)}<input name="phone" type="tel" inputmode="tel" maxlength="20" autocomplete="tel" placeholder="0812 3456 7890" required /></label>
        <p class="muted small">{L(ui.online.phoneHint)}</p>
        <fieldset class="choice"><legend>{L(ui.online.pickupBy)}</legend>
          <label><input type="radio" name="pickup_by" value="customer" checked /> {L(ui.online.byCustomer)}</label>
          <label><input type="radio" name="pickup_by" value="courier" /> {L(ui.online.byCourier)}</label>
        </fieldset>
        <fieldset class="choice"><legend>{L(ui.online.pay)}</legend>
          <label><input type="radio" name="pay_plan" value="at_pickup" checked /> {L(ui.online.payAtPickup)}</label>
          {prepay && <label><input type="radio" name="pay_plan" value="prepay_qris" /> {L(ui.online.payPrepay)}</label>}
        </fieldset>
        <label>{L(ui.online.note)}<input name="note" maxlength="200" /></label>
        {sitekey && <div id="captcha" class="captcha"></div>}
        <p id="orderErr" class="err" role="alert"></p>
        <button class="btn vm" type="submit" id="orderBtn">{lbl(site, lang, 'send_order', L(ui.online.send))}</button>
      </aside>
    </form>
  </div></section>
)}

# Alamat backend (API publik). Kosongkan = mode contoh: website menampilkan data bawaan Aisin
# dan pemesanan dinonaktifkan. Di Cloudflare isi di Settings > Variables and Secrets.
API_URL=https://api.contoh.com

# Hanya untuk pengembangan/pratinjau (localhost, *.pages.dev): slug restoran yang ditampilkan
# bila domain tidak dikenal. JANGAN diisi di produksi.
DEFAULT_SITE_SLUG=aisin

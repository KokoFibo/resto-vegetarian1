# Alamat backend (API publik, mis. api.kokofibo.com). Kosongkan = mode contoh: website menampilkan data bawaan Aisin
# dan pemesanan dinonaktifkan. Di Cloudflare isi di Settings > Variables and Secrets.
API_URL=https://api.contoh.com

# Hanya untuk pengembangan/pratinjau (localhost, *.pages.dev): slug restoran yang ditampilkan
# bila domain tidak dikenal. JANGAN diisi di produksi.
DEFAULT_SITE_SLUG=aisin

# Alamat publik bucket gambar Cloudflare R2 (tanpa garis miring akhir), mis. https://images.kokofibo.com.
# Dipakai untuk gambar BAWAAN template (restaurant/defaults/aisin/...). Kosong = cadangan lokal /images/<berkas>
# (folder public/images tetap ada). Foto menu dan foto hero kustom sudah berupa URL penuh dari API.
MEDIA_URL=

# Hanya mode contoh (API_URL kosong): menyalakan keadaan dari admin untuk uji tampilan. Boleh beberapa, dipisah koma:
#   closed | banners | featured | hero-custom | theme-giok|teh|samudra|bata|anggur|zaitun|arang | theme-custom | theme-dark
# DEMO_SCENARIO=banners,theme-samudra
